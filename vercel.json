{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pdc-app-vm0t.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://pdc-app-vm0t.onrender.com/uploads/:path*"
    },
    {
      "source": "/work/:slug",
      "destination": "/"
    }
  ]
}
